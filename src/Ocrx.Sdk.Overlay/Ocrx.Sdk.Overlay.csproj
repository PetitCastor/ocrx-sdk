<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ocrx.Sdk\Ocrx.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Ocrx.Sdk.Overlay</PackageId>
    <Description>Opt-in click-through desktop overlay sink for Ocrx plugins.</Description>
    <PackageTags>star-citizen;screen-capture;overlay;plugin;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ocrx.Sdk.Overlay.Tests" />
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
